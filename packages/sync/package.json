	"contributors": [
		{
			"name": "DrAv0011",
			"email": "contact@drav.dev",
			"url": "https://drav.dev"
		}
	],
	"repository": "github:bedrock-core/server",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
