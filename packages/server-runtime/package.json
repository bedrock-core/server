{
	"name": "@bedrock-core/server-runtime",
	"version": "0.2.1",
	"description": "The bedrock-core server runtime: addon registration and a cross-addon registry, built on @bedrock-core/sync",
	"keywords": [
		"minecraft",
		"bedrock",
		"cross-addon",
		"runtime",
		"registry",
		"framework"
	],
	"license": "MIT",
	"author": "DrAv0011",
	"contributors": [
		{
			"name": "DrAv0011",
			"email": "contact@drav.dev",
			"url": "https://drav.dev"
		}
	],
	"repository": "github:bedrock-core/server",
	"type": "module",
	"exports": {
		"./i18n": {
			"types": "./src/i18n/index.ts",
			"import": "./src/i18n/index.ts"
		},
		"./i18n/publish": {
			"types": "./src/i18n/publish.ts",
			"import": "./src/i18n/publish.ts"
		},
		"./library": {
			"types": "./src/library.ts",
			"import": "./src/library.ts"
		},
		"./api/native-values": {
			"types": "./src/api/native-values.ts",
			"import": "./src/api/native-values.ts"
		},
		"./api/native-access": {
			"types": "./src/api/native-access.ts",
			"import": "./src/api/native-access.ts",
			"default": "./src/api/native-access.ts"
		},
		"./api/client": {
			"types": "./src/api/client.ts",
			"import": "./src/api/client.ts"
		},
		"./api": {
			"types": "./src/api/index.ts",
			"import": "./src/api/index.ts"
		},
		"./manifest": {
			"types": "./src/manifest.ts",
			"import": "./src/manifest.ts"
		},
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src/**/*",
		"!src/**/__type-tests__/**"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"lint": "eslint .",
		"test": "vitest run",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@bedrock-core/i18n": "workspace:^",
		"@bedrock-core/observable": "workspace:^",
		"@bedrock-core/sync": "workspace:^"
	},
	"devDependencies": {
		"@minecraft/server": "*",
		"@stylistic/eslint-plugin": "*",
		"eslint": "*",
		"typescript": "*",
		"typescript-eslint": "*",
		"vitest": "*"
	},
	"peerDependencies": {
		"@minecraft/server": ">=2.9.0 || >=2.10.0-0"
	}
}
